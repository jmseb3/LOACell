CREATE TABLE Character (
  name TEXT NOT NULL PRIMARY KEY,
  username TEXT NOT NULL ,
  roomId TEXT NOT NULL,
  server TEXT NOT NULL,
  className TEXT NOT NULL,
  level TEXT NOT NULL,
  FOREIGN KEY(username,roomId) REFERENCES UserInfo(name,roomId) ON DELETE CASCADE
);

insertCharacterInfo:
INSERT OR REPLACE INTO Character
VALUES (?,?,?,?,?,?);

selectByuserId:
SELECT * FROM Character WHERE username = ? AND roomId =?;

checkAlreadyExist:
SELECT EXISTS (
SELECT name FROM  Character WHERE name =?
);