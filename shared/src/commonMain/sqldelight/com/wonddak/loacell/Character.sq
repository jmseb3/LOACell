CREATE TABLE Character (
  name TEXT NOT NULL PRIMARY KEY,
  server TEXT NOT NULL,
  className TEXT NOT NULL,
  level TEXT NOT NULL
);

insertCharacterInfo:
INSERT OR REPLACE INTO Character
VALUES (?,?,?,?);

getCharacterInfo:
SELECT * FROM Character WHERE name = ?;

updateCharacterInfo:
UPDATE Character SET server = ?, className =?, level =? WHERE name =?;

deleteUserByName:
DELETE FROM Character WHERE  name =?;