CREATE TABLE Character (
  name TEXT NOT NULL PRIMARY KEY,
  userName TEXT  NOT NULL,
  representativeCharacter TEXT NOT NULL ,
  server TEXT NOT NULL,
  class TEXT NOT NULL,
  level TEXT NOT NULL,
  FOREIGN KEY(userName,representativeCharacter) REFERENCES UserInfo(name,representativeCharacter) ON DELETE CASCADE
);

insertCharacterInfo:
INSERT OR REPLACE INTO Character(name,userName,representativeCharacter,server,class,level)
VALUES (?,?,?,?,?,?);

selectByRepresentativeCharacter:
SELECT * FROM Character WHERE representativeCharacter = ?;