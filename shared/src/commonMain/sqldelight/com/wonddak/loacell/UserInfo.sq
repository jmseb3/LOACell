CREATE TABLE UserInfo (
  userId INTEGER PRIMARY KEY AUTOINCREMENT,
  roomId INTEGER NOT NULL,
  name TEXT NOT NULL,
  representativeCharacter Text NOT NULL ,
  FOREIGN KEY(roomId) REFERENCES RoomInfo(id) ON DELETE CASCADE
);

insertUserInfo:
INSERT INTO UserInfo VALUES (?,?,?,?);

lastInsertRowId:
SELECT last_insert_rowid();

selectByRoomId:
SELECT * FROM UserInfo WHERE roomId = ?;