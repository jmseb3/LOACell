CREATE TABLE UserInfo (
  userId INTEGER PRIMARY KEY AUTOINCREMENT,
  roomId TEXT NOT NULL,
  name TEXT NOT NULL,
  representativeCharacter Text NOT NULL ,
  FOREIGN KEY(roomId) REFERENCES RoomInfo(uniqueId) ON DELETE CASCADE
);

insertUserInfo:
INSERT INTO UserInfo VALUES (?,?,?,?);

upadteRepresentativeCharacter:
UPDATE UserInfo SET representativeCharacter = ?  WHERE  userId =?;

lastInsertRowId:
SELECT last_insert_rowid();

selectByRoomId:
SELECT * FROM UserInfo WHERE roomId = ?;

deleteUserById:
DELETE FROM UserInfo WHERE  userId =?;