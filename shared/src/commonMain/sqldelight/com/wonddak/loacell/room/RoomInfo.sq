insertRoomInfo:
INSERT INTO RoomInfo VALUES (?,?);

selectAll:
SELECT * FROM RoomInfo;

selectById:
SELECT * FROM RoomInfo WHERE id = ?;

deleteById:
DELETE FROM RoomInfo WHERE id = ?;