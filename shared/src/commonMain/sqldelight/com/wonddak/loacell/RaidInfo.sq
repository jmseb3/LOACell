import com.wonddak.loacell.database.const.Difficulty;
import com.wonddak.loacell.database.const.RaidType;

CREATE TABLE RaidInfo (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  roomId INTEGER NOT NULL,
  title TEXT NOT NULL,
  type Text AS RaidType,
  Difficulty INTEGER AS Difficulty,
  maxPerson INTEGER NOT NULL,
  minLevel INTEGER NOT NULL,
  FOREIGN KEY(roomId) REFERENCES RoomInfo(id) ON DELETE CASCADE
);

selectByRoomId:
SELECT * FROM RaidInfo WHERE roomId = ?;

insertRaidInfo:
INSERT INTO RaidInfo VALUES (?,?,?,?,?,?,?);

delete:
DELETE FROM RaidInfo WHERE id =?;