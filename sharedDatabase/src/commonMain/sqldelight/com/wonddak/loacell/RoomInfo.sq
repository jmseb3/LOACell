import kotlin.String;
import kotlin.collections.List;

CREATE TABLE RoomInfo (
  uniqueId TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  description TEXT NOT NULL,
  owner Text NOT NULL,
  enterUser TEXT AS List<String> NOT NULL,
  editableUser TEXT AS List<String> NOT NULL,
  anoymousUser TEXT AS List<String> NOT NULL
);

insertRoomInfo:
INSERT INTO RoomInfo VALUES (?,?,?,?,?,?,?);

selectAll:
SELECT * FROM RoomInfo;

selectById:
SELECT * FROM RoomInfo WHERE uniqueId = ?;

selectByOwner:
SELECT * FROM RoomInfo WHERE owner = ?;

updateInfo:
UPDATE RoomInfo SET title =?, description =? ,owner=?,enterUser=?,editableUser =?,anoymousUser=? WHERE uniqueId =?;

deleteById:
DELETE FROM RoomInfo WHERE uniqueId = ?;

deleteAll:
DELETE FROM RoomInfo;