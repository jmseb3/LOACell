import com.wonddak.loacell.Character;
import kotlin.String;
import kotlin.collections.List;

CREATE TABLE UserInfo (
  name TEXT NOT NULL,
  roomId TEXT NOT NULL,
  representativeCharacter Text NOT NULL,
  characterList TEXT AS List<Character> NOT NULL,
  timeStamp INTEGER,
  FOREIGN KEY(roomId) REFERENCES RoomInfo(uniqueId) ON DELETE CASCADE,
  PRIMARY KEY(name,roomId)
);

insertUserInfo:
INSERT OR REPLACE INTO UserInfo VALUES (?,?,?,?,?);

updateUserInfo:
UPDATE UserInfo SET representativeCharacter = ?,characterList=?,timeStamp =? WHERE name =? AND roomId = ?;

updateRepresentativeCharacter:
UPDATE UserInfo SET representativeCharacter = ? WHERE name =? AND roomId = ?;

selectByRoomId:
SELECT * FROM UserInfo WHERE roomId = ?;

selectByName:
SELECT * FROM UserInfo WHERE roomId = ? AND name=?;

deleteUserById:
DELETE FROM UserInfo WHERE  name =? AND roomId =?;