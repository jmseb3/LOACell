CREATE TABLE Character (
  userName TEXT NOT NULL,
  roomId TEXT NOT NULL,
  name TEXT NOT NULL,
  server TEXT NOT NULL,
  className TEXT NOT NULL,
  level TEXT NOT NULL,
  FOREIGN KEY(userName,roomId) REFERENCES UserInfo(name,roomId) ON DELETE CASCADE,
  PRIMARY KEY(userName,roomId,name)
);

insertCharacter:
INSERT OR REPLACE INTO Character VALUES (?,?,?,?,?,?);

updateUserInfo:
UPDATE Character SET server = ?,className =?,level=? WHERE userName =? AND roomId = ? AND name =?;

selectAllByRoomId:
SELECT * FROM Character WHERE roomId = ?;

selectAllByUser:
SELECT * FROM Character WHERE userName = ? AND roomId = ?;

selectOneByName:
SELECT * FROM Character WHERE userName = ? AND roomId = ? AND name=?;

deleteUserByName:
DELETE FROM Character WHERE roomId = ? AND name=?;