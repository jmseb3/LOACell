import com.wonddak.database.model.Day;
import com.wonddak.database.model.RaidType;
import com.wonddak.database.model.Difficulty;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

CREATE TABLE RaidInfo (
  raidId TEXT NOT NULL PRIMARY KEY,
  roomId TEXT NOT NULL,
  title TEXT NOT NULL,
  type Text AS RaidType NOT NULL,
  Difficulty INTEGER AS Difficulty NOT NULL ,
  startGateNumber INTEGER NOT NULL,
  endGateNumber INTEGER NOT NULL,
  isFinish INTEGER AS Boolean NOT NULL,
  party1characterList TEXT AS List<String> NOT NULL,
  party2characterList TEXT AS List<String> NOT NULL,
  day INTEGER AS Day NOT NULL,
  hour INTEGER NOT NULL,
  minute INTEGER NOT NULL,
  party3characterList TEXT AS List<String> NOT NULL,
  party4characterList TEXT AS List<String> NOT NULL,
  FOREIGN KEY(roomId) REFERENCES RoomInfo(uniqueId) ON DELETE CASCADE
);

selectByRoomId:
SELECT * FROM RaidInfo WHERE roomId = ?;

selectByRaidId:
SELECT * FROM RaidInfo WHERE roomId = ? AND raidId=?;

insertRaidInfo:
INSERT INTO RaidInfo VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

updateRaidInfo:
UPDATE RaidInfo SET title = ?, type =?, Difficulty =?,startGateNumber =?, endGateNumber =?,isFinish =? ,party1characterList =?,party2characterList =? ,day =?, hour =?, minute =?,party3characterList =?,party4characterList =? WHERE raidId =? AND  roomId =?;

updateDay:
UPDATE RaidInfo SET day =?,hour =?,minute =? WHERE raidId =? AND  roomId =?;

delete:
DELETE FROM RaidInfo WHERE raidId =? AND roomId =?;